/*
 * EPIquence | environment configuration
 * cp conf/env.config.template conf/env.config && chmod 600 conf/env.config
 */

params {
    // Reference databases
    busco_db        = "/data/databases/busco"
    bakta_db        = "/data/databases/bakta/1.11.4/db"         // full DB (high_capacity)
    gtdbtk_db       = "/data/databases/gtdb/release226"

    // Host size: all threads, and RAM minus ~2 GB (small host) or ~8 GB (server)
    max_cpus   = 176
    max_memory = 300.GB

    // Species engine for command-line runs: gtdbtk | sylph | both (the launcher follows the profile)
    // taxonomy_tool  = "sylph"

    // sylph: same GTDB release as gtdbtk_db. c1000 (3.7 GB) for small hosts, c200 (18.4 GB) for servers.
    //   http://faust.compbio.cs.cmu.edu/sylph-stuff/gtdb-r226-c1000-dbv1.syldb
    //   https://data.gtdb.ecogenomic.org/releases/release226/226.0/ (bac120_ and ar53_taxonomy_r226.tsv.gz)
    sylph_db       = "/data/databases/sylph/gtdb-r226-c1000-dbv1.syldb"
    sylph_taxonomy = "/data/databases/sylph/bac120_taxonomy_r226.tsv.gz,/data/databases/sylph/ar53_taxonomy_r226.tsv.gz"

    // Results database and surveillance (a password in the URL is never written to work/)
    surveillance_db_url      = "sqlite:////data/databases/epiquence/epiquence_db.db"
    // surveillance_db_url   = "postgresql+psycopg2://epiquence:secret@db.example.org:5432/epiquence"
    surveillance_sketch_dir  = "/data/databases/epiquence/surveillance"
    surveillance_results_dir = "/data/databases/epiquence/surveillance-results"   // all/, <group_id>/, ungrouped/
    analysis_report_dir      = "/data/databases/epiquence/analysis_reports"

    report_timezone          = "America/Chicago"   // IANA zone

    // Optional Metabase refresh after each load (all three required)
    // metabase_base_url    = "https://metabase.example.org"
    // metabase_db_id       = "2"
    // metabase_api_key     = "mb_xxxxxxxxxxxxxxxxxxxxxxxx"

    // MultiQC AI summary (local OpenAI-compatible endpoint, e.g. Ollama)
    ai_summary        = true                                          // short AI interpretation of the report
    ai_summary_full   = true                                          // detailed AI interpretation (slower)
    ai_model          = 'gemma4'                                      // Ollama model name (as `ollama list` shows)
    ai_endpoint       = 'http://localhost:11434/v1/chat/completions'  // OpenAI-compatible chat endpoint
    ai_context_window = 131072                                        // MUST match Ollama's num_ctx (OLLAMA_CONTEXT_LENGTH=131072)
}

// Works with Apptainer and SingularityCE. cacheDir holds the images Nextflow runs (see scripts/prefetch_containers.sh).
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = "/data/apps/singularity/cache"
    pullTimeout = '1h'
    runOptions  = '--bind /data/databases:/data/databases --bind /data/tmp:/tmp'
}

conda {
    enabled     = true
    cacheDir    = "/data/apps/conda/envs/"
}

executor {
    name   = 'local'
    cpus   = params.max_cpus
    memory = params.max_memory
}
