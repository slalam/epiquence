/*
 * EPIquence configuration
 * Host-specific settings live in conf/env.config (see conf/env.config.template).
 */

includeConfig 'conf/env.config'

manifest {
    name            = 'EPIquence | Sequence to Surveillance'
    description     = 'A scalable pipeline that converts raw sequencing data into high resolution bacterial surveillance insights, integrating QC, assembly, characterization, clustering, and outbreak detection'
    mainScript      = 'main.nf'
    nextflowVersion = '25.10.2'
    version         = '1.0.0'
    license         = 'MIT'
}


params {
    sample_sheet    = null
    assemblies_dir  = null         // Pre-built assemblies; samples get the _A suffix
    outdir          = "results"
    
    // Assembly types, comma-separated: L, S, HL, HS or ALL
    assembly_type   = "ALL"
    medaka_model    = "r1041_e82_400bps_sup_v5.0.0"

    // Long-read subsampling
    rasusa_coverage     = 100       // Target coverage for long read subsampling
    rasusa_genome_size  = "6mb"
    skip_rasusa         = false
    amr_priority_genes  = ''       // e.g. 'blaKPC*,blaNDM*,mcr-1'
    plasmid_min_length     = 1000    // Minimum contig length to consider (exclude artifacts)
    // Assembly types where the HGT unit is a contig, not the whole MOB bin
    plasmid_hgt_contig_types = 'HL,HS'

    plasmid_circular_min   = 20000   // Minimum length for circular contig to be primary replicon
    plasmid_fragment_min   = 5000    // Minimum length for linear fragment (when no circular exists)
    plasmid_containment_cov = 80     // % coverage for redundancy detection
    plasmid_containment_id  = 90     // % identity for redundancy detection
    comparison_map_palette  = 'cool' // 'warm', 'cool' or 'earth'
    plasmid_map_group_mode  = 'auto' // 'auto', 'split' (one map per replicon group) or 'single'
    
    // Host size (max_cpus, max_memory) is set in conf/env.config only.
    
    // Stop after 'qc', 'assembly', 'polish', or run 'all'
    stop_at         = "all"

    // Workflow tracking
    workflow_id          = null      // default: WMMDDYYHHMMSS local time
    workflow_description = ""
    group_id             = "GP001"
    group_description    = "Healthcare-Associated Infections"

    metadata             = null      // Path to metadata CSV/TSV (optional)

    // GTDB species -> AMRFinderPlus / ResFinder organism (enables point mutations)
    amrfinder_organism_map = [
        'Acinetobacter baumannii'         : 'Acinetobacter_baumannii',
        'Acinetobacter calcoaceticus'     : 'Acinetobacter_baumannii',
        'Acinetobacter pittii'            : 'Acinetobacter_baumannii',
        'Acinetobacter nosocomialis'      : 'Acinetobacter_baumannii',
        'Acinetobacter seifertii'         : 'Acinetobacter_baumannii',
        'Acinetobacter dijkshoorniae'     : 'Acinetobacter_baumannii',
        'Acinetobacter lactucae'          : 'Acinetobacter_baumannii',

        'Bordetella pertussis'            : 'Bordetella_pertussis',

        'Burkholderia pseudomallei'       : 'Burkholderia_pseudomallei',
        'Burkholderia thailandensis'      : 'Burkholderia_pseudomallei',
        'Burkholderia mallei'             : 'Burkholderia_mallei',
        'Burkholderia cepacia'            : 'Burkholderia_cepacia',
        'Burkholderia cenocepacia'        : 'Burkholderia_cepacia',
        'Burkholderia multivorans'        : 'Burkholderia_cepacia',
        'Burkholderia vietnamiensis'      : 'Burkholderia_cepacia',
        'Burkholderia dolosa'             : 'Burkholderia_cepacia',
        'Burkholderia ambifaria'          : 'Burkholderia_cepacia',
        'Burkholderia stabilis'           : 'Burkholderia_cepacia',
        'Burkholderia anthina'            : 'Burkholderia_cepacia',
        'Burkholderia pyrrocinia'         : 'Burkholderia_cepacia',
        'Burkholderia contaminans'        : 'Burkholderia_cepacia',
        'Burkholderia lata'               : 'Burkholderia_cepacia',

        'Campylobacter'                   : 'Campylobacter',

        'Citrobacter freundii'            : 'Citrobacter_freundii',
        'Clostridioides difficile'        : 'Clostridioides_difficile',
        'Corynebacterium diphtheriae'     : 'Corynebacterium_diphtheriae',
        'Enterobacter asburiae'           : 'Enterobacter_asburiae',
        'Enterobacter cloacae'            : 'Enterobacter_cloacae',
        'Enterococcus faecalis'           : 'Enterococcus_faecalis',
        'Enterococcus faecium'            : 'Enterococcus_faecium',
        'Enterococcus hirae'              : 'Enterococcus_faecium',   // per Notes

        // Use for Shigella and Escherichia
        'Escherichia'                     : 'Escherichia',
        'Shigella'                        : 'Escherichia',

        'Haemophilus influenzae'          : 'Haemophilus_influenzae',

        'Klebsiella oxytoca'              : 'Klebsiella_oxytoca',
        'Klebsiella michiganensis'        : 'Klebsiella_oxytoca',
        'Klebsiella grimontii'            : 'Klebsiella_oxytoca',
        'Klebsiella huaxiensis'           : 'Klebsiella_oxytoca',
        'Klebsiella pasteurii'            : 'Klebsiella_oxytoca',
        'Klebsiella spallanzanii'         : 'Klebsiella_oxytoca',
        'Klebsiella'                      : 'Klebsiella_pneumoniae',

        'Neisseria gonorrhoeae'           : 'Neisseria_gonorrhoeae',
        'Neisseria meningitidis'          : 'Neisseria_meningitidis',
        'Pseudomonas aeruginosa'          : 'Pseudomonas_aeruginosa',
        'Salmonella'                      : 'Salmonella',
        'Serratia marcescens'             : 'Serratia_marcescens',
        'Staphylococcus aureus'           : 'Staphylococcus_aureus',
        'Staphylococcus epidermidis'      : 'Staphylococcus_epidermidis',
        'Staphylococcus pseudintermedius' : 'Staphylococcus_pseudintermedius',
        'Streptococcus agalactiae'        : 'Streptococcus_agalactiae',
        'Streptococcus pneumoniae'        : 'Streptococcus_pneumoniae',
        'Streptococcus mitis'             : 'Streptococcus_pneumoniae',   // per Notes
        'Streptococcus pyogenes'          : 'Streptococcus_pyogenes',
        'Vibrio cholerae'                 : 'Vibrio_cholerae',
        'Vibrio parahaemolyticus'         : 'Vibrio_parahaemolyticus',
        'Vibrio vulnificus'               : 'Vibrio_vulnificus'
    ]

    resfinder_species_map = [
        'Campylobacter coli'         : 'Campylobacter coli',
        'Campylobacter jejuni'       : 'Campylobacter jejuni',
        'Enterococcus faecalis'      : 'Enterococcus faecalis',
        'Enterococcus faecium'       : 'Enterococcus faecium',
        'Escherichia coli'           : 'Escherichia coli',
        'Helicobacter pylori'        : 'Helicobacter pylori',
        'Klebsiella'                 : 'Klebsiella',
        'Mycobacterium tuberculosis' : 'Mycobacterium tuberculosis',
        'Neisseria gonorrhoeae'      : 'Neisseria gonorrhoeae',
        'Salmonella'                 : 'Salmonella enterica',
        'Staphylococcus aureus'      : 'Staphylococcus aureus'
    ]

    // GTDB species -> forced MLST scheme
    species_scheme_map = [
        'Citrobacter freundii': 'cfreundii',
        'Escherichia coli': 'ecoli_achtman_4',
        'Klebsiella ornithinolytica': 'koxytoca',
        'Klebsiella michiganensis': 'koxytoca',
        'Klebsiella pneumoniae': 'klebsiella',
        'Proteus mirabilis': 'proteus',
        'Yersinia enterocolitica': 'yersinia',
        'Yersinia intermedia': 'yersinia',
        'Yersinia mollaretii': 'yersinia',
        'Yersinia alsatica': 'yersinia'
    ]

    // Species routed to each typing tool
    ectyper_species    = 'Escherichia coli'
    kleborate_kpsc_species = 'Klebsiella pneumoniae,Klebsiella quasipneumoniae,Klebsiella variicola,Klebsiella africana'
    kleborate_kosc_species = 'Klebsiella oxytoca,Klebsiella michiganensis,Klebsiella grimontii,Klebsiella pasteurii,Klebsiella spallanzanii,Klebsiella huaxiensis'
    emmtyper_species   = 'Streptococcus pyogenes'
    sistr_species       = 'Salmonella'
    seroba_species      = 'Streptococcus pneumoniae'
    meningotype_species = 'Neisseria meningitidis'
    elgato_species      = 'Legionella pneumophila'

    // Outbreak detection
    outbreak             = false     // Enable with --outbreak
    outbreak_threshold   = 0.05      // Mash distance clustering threshold (matches launcher default)
    core_genome          = false     // Bakta + Panaroo for clusters of 5+

    // Plasmid HGT detection
    plasmid_hgt          = false     // Enable with --plasmid_hgt
    hgt_maps             = false     // Enable with --hgt_maps (requires --plasmid_hgt)
    hgt_mash_threshold   = 0.005    // Mash distance threshold for plasmid clustering
    hgt_sketch_size      = 5000     // Mash sketch size for plasmid comparison
    amr_tree_min_genomes = 3        // Min AMR plasmids before mashtree builds a real tree
    hgt_matrix_max_plasmids = 120   // Above this, the AMR Mash matrix is download-only

    // MultiQC report text
    multiqc_title          = "Bacterial Genomic Surveillance Report"

    // MultiQC AI summary settings (ai_*) are set in conf/env.config only.
    multiqc_subtitle       = ""
    multiqc_intro          = "Integrated analysis of genome assembly, species identification, antimicrobial resistance, plasmid characterization, and outbreak clustering"

    surveillance            = false    // Results DB + cumulative SKA2/ReporTree
    // Surveillance (chromosome bins only)
    surveillance_include_superseded = false

    surveillance_min_chromosome_bp = 500000
    surveillance_tree_snp_cap      = 100
    surveillance_tree_max_pairs    = 500000


    surveillance_distance_color_break = 100
    // Below this many isolates the matrix is drawn with a value in every cell.
    surveillance_distance_vector_max = 300
    surveillance_distance_max_isolates = 4000

    surveillance_group_views = true

    // sylph call thresholds (taxonomy_tool, sylph_db, sylph_taxonomy are set in conf/env.config)
    sylph_species_ani    = 95
    sylph_borderline_ani = 94
    sylph_min_margin     = 0.5

    // NOTE: analysis_report_dir and report_timezone are set in conf/env.config only;
    // a default here would override it.


    metabase_timeout_seconds       = 120

}


env {
    // Containers default to UTC; pass the configured timezone into every task.
    TZ = params.report_timezone ?: (System.getenv('TZ') ?: 'UTC')
}


timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}


process {
    executor        = 'local'
    errorStrategy   = 'finish'
    maxForks        = null

    // Default resources (without -profile)
    withLabel: 'process_low'    { cpus = 8;  memory = 8.GB }
    withLabel: 'process_medium' { cpus = 16; memory = 16.GB }
    withLabel: 'process_high'   { cpus = 20; memory = 18.GB }
    withLabel: 'process_max'    { cpus = 50; memory = 60.GB }

    // Containers

    withName: 'VALIDATE_READS'   { container = 'docker://staphb/seqkit:2.12.0' }
    withName: 'CHECK_VALIDATION' { container = 'docker://staphb/seqkit:2.12.0' }
    withName: 'SEQKIT_STATS'    { container = 'docker://staphb/seqkit:2.12.0' }
    withName: 'PARSE_SEQKIT_STATS' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'NANOPLOT'        { container = 'docker://staphb/nanoplot:1.46.2' }
    withName: 'PARSE_NANOPLOT'  { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'FASTPLONG'       { container = 'docker://staphb/fastplong:0.4.1' }
    withName: 'RASUSA'          { container = 'docker://staphb/rasusa:3.0.0' }
    withName: 'FASTP_SHORT'     { container = 'docker://staphb/fastp:1.0.1' }
    withName: 'PARSE_FASTP'     { container = 'docker://quay.io/biocontainers/python:3.12.12' }

    withName: 'FLYE'            { container = 'docker://staphb/flye:2.9.6' }
    withName: 'MEDAKA'          { container = 'docker://staphb/medaka:2.0.0' }
    withName: 'UNICYCLER'       { container = 'docker://staphb/unicycler:0.5.1' }
    // withName matches the full process name, so DNAAPLER_ASSEMBLY is listed explicitly.
    withName: 'DNAAPLER|DNAAPLER_ASSEMBLY' { container = 'docker://staphb/dnaapler:1.3.0' }

    withName: 'POLYPOLISH_ALIGN'{ container = 'docker://quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0' }
    withName: 'POLYPOLISH'      { container = 'docker://staphb/polypolish:0.6.1' }

    withName: 'ALIGN_LONG'      { container = 'docker://staphb/minimap2:2.30' }
    withName: 'ALIGN_SHORT'     { container = 'docker://quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0' }
    withName: 'SAMTOOLS_SORT'   { container = 'docker://staphb/samtools:1.21' }

    withName: 'MOSDEPTH'        { container = 'docker://quay.io/biocontainers/mosdepth:0.3.3--h37c5b7d_2' }
    withName: 'PARSE_MOSDEPTH'  { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'QUAST'           { container = 'docker://staphb/quast:5.3.0' }
    withName: 'PARSE_QUAST'     { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'BUSCO'           { container = 'docker://staphb/busco:6.0.0' }

    withName: 'MLST'            { container = 'docker://staphb/mlst:2.32.2' }
    withName: 'MLST_WITH_SCHEME' { container = 'docker://staphb/mlst:2.32.2' }
    withName: 'PARSE_MLST'      { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'GTDBTK'          { 
        container = 'docker://ecogenomic/gtdbtk:2.6.1'
        cpus = 50
        memory = 60.GB
        maxForks = 2
        containerOptions = '--bind /usr/bin/ps:/usr/bin/ps'
    }
    withName: 'PARSE_GTDBTK'    { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'SYLPH_QUERY'     { container = 'docker://staphb/sylph:1.0.0' }
    withName: 'PARSE_SYLPH'     { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'AMRFINDERPLUS'   { container = 'docker://staphb/ncbi-amrfinderplus:4.2.7-2026-08-07.1' }
    withName: 'RESFINDER'       { container = 'docker://staphb/resfinder:4.7.2' }
    withName: 'VIRULENCEFINDER' { container = 'docker://staphb/virulencefinder:3.2.0' }
    withName: 'PARSE_VIRULENCEFINDER' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'PARSE_AMRFINDER' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'PARSE_RESFINDER' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'MOB_RECON'       { container = 'docker://quay.io/biocontainers/mob_suite:3.1.9--pyhdfd78af_1' }
    withName: 'PARSE_MOB_RECON' { container = 'docker://quay.io/biocontainers/python:3.12.12' }

    withName: 'ANNOTATION_SUMMARY' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'RENAME_CONTIGS' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'ANNOTATE_PLASMIDS' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'COLLECT_ASSEMBLIES' { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'COLLECT_PLASMIDS' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'COLLECT_CHROMOSOMES_SUMMARY' { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'GENERATE_MULTIQC_CONFIG' { container = 'docker://staphb/multiqc:1.35' }
    withName: 'MULTIQC'         { container = 'docker://staphb/multiqc:1.35' }

    withName: 'EXTRACT_CHROMOSOME' { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'STORE_RESULTS_DB' {
        container = null
        conda = 'conda-forge::sqlalchemy conda-forge::psycopg2'
    }
    // Same env as STORE_RESULTS_DB (needs sqlalchemy).
    withName: 'FINALIZE_WORKFLOW_LOG' {
        container = null
        conda = 'conda-forge::sqlalchemy conda-forge::psycopg2'
    }
    // Runs on the host to use its network route to Metabase.
    withName: 'METABASE_RESCAN' { container = null }
    withName: 'LOAD_SURVEILLANCE_DB' {
        container = null
        conda = 'conda-forge::sqlalchemy conda-forge::psycopg2'
    }
    withName: 'SKA_BUILD'       { container = 'docker://staphb/ska2:0.5.1' }
    withName: 'SKA_MERGE'       { container = 'docker://staphb/ska2:0.5.1' }
    withName: 'SKA_DISTANCE'    { container = 'docker://staphb/ska2:0.5.1' }
    withName: 'REPORTREE'       {
        container = 'docker://insapathogenomics/reportree:v2.6.0'
        containerOptions = '--bind /usr/bin/ps:/usr/bin/ps'
    }
    withName: 'PREPARE_ISOLATES_TSV' { container = null }
    withName: 'UPDATE_CUMULATIVE_ISOLATES' { container = null }
    withName: 'SURVEILLANCE_TREE' { container = null }
    withName: 'SURVEILLANCE_DISTANCE_MATRIX' {
        container = 'docker://quay.io/biocontainers/mulled-v2-0fd299cadb7a80e2cc704b5d903ccc54893c512d:377fcafe3b6e7ef703094f8f47a64d081622ee09-2'
        memory = { 4.GB * task.attempt }
    }

    withName: 'COLLECT_CHROMOSOMES' { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'MASHTREE'        { container = 'docker://staphb/mashtree:1.4.6' }
    withName: 'OUTBREAK_CLUSTER' { container = 'docker://quay.io/biocontainers/mulled-v2-0fd299cadb7a80e2cc704b5d903ccc54893c512d:377fcafe3b6e7ef703094f8f47a64d081622ee09-2' }
    withName: 'SKA_ALIGNMENT'     {
        container = 'docker://staphb/ska2:0.5.1'
        cpus = 8
        memory = '8 GB'
    }
    withName: 'BAKTA_CGA'    {
        container = 'docker://staphb/bakta:1.11.4'
        cpus = 4
        memory = '30.GB'
        maxForks = 1
    }
    withName: 'PANAROO'           {
        container = 'docker://staphb/panaroo:1.6.0'
        cpus = 12
        memory = '16 GB'
    }
    withName: 'SNP_DISTS_CORE'    { container = 'docker://staphb/snp-dists:1.2.0' }
    withName: 'SNP_DISTS_CGA'    { container = 'docker://staphb/snp-dists:1.2.0' }
    withName: 'IQTREE'            { container = 'docker://staphb/iqtree3:3.0.1' }
    withName: 'IQTREE_CGA'       { container = 'docker://staphb/iqtree3:3.0.1' }
    withName: 'ASSEMBLE_OUTBREAK_RESULTS' { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'RENDER_TREES'    {
        container = null
        conda = 'toytree'
    }
    withName: 'RENDER_CGA_TREES'    {
        container = null
        conda = 'toytree'
    }
    withName: 'BUILD_OUTBREAK_REPORT' { container = 'docker://quay.io/biocontainers/mulled-v2-0fd299cadb7a80e2cc704b5d903ccc54893c512d:377fcafe3b6e7ef703094f8f47a64d081622ee09-2' }

    withName: 'COLLECT_PLASMID_FASTAS' { container = 'docker://quay.io/biocontainers/python:3.12.12' }
    withName: 'MASH_DIST_PLASMIDS'    { container = 'docker://staphb/mashtree:1.4.6' }
    withName: 'CLUSTER_PLASMIDS'       { container = 'docker://quay.io/biocontainers/mulled-v2-0fd299cadb7a80e2cc704b5d903ccc54893c512d:377fcafe3b6e7ef703094f8f47a64d081622ee09-2' }
    withName: 'UMAP_PLASMIDS'          {
        container = null
        conda = 'conda-forge::umap-learn conda-forge::altair-all conda-forge::pandas conda-forge::numpy'
    }
    withName: 'PLASMID_ANI_AF'         { container = 'docker://staphb/mummer:4.0.1' }
    withName: 'MASHTREE_AMR_PLASMIDS'  { container = 'docker://staphb/mashtree:1.4.6' }
    withName: 'AMR_PLASMID_MATRIX'     { container = 'docker://quay.io/biocontainers/mulled-v2-0fd299cadb7a80e2cc704b5d903ccc54893c512d:377fcafe3b6e7ef703094f8f47a64d081622ee09-2' }
    // Needs Python and minimap2 2.30 together; no published image has both.
    withName: 'SELECT_PLASMID_REF'     {
        container = null
        conda = 'bioconda::minimap2=2.30 conda-forge::python=3.12'
    }
    withName: 'BAKTA_PLASMID_REF'      {
        container = 'docker://staphb/bakta:1.11.4'
        cpus = 4
        memory = '16.GB'
    }
    withName: 'COMPARISON_MAP'          {
        container = 'docker://staphb/bakta:1.11.4'
        cpus = 4
        memory = '16.GB'
    }
    withName: 'ASSEMBLE_HGT_RESULTS'   { container = 'docker://quay.io/biocontainers/ubuntu:22.04' }
    withName: 'BUILD_HGT_REPORT'       {
        container = null
        conda = 'conda-forge::altair-all conda-forge::pyyaml'
    }
    withName: 'RENDER_HGT_TREES'       {
        container = null
        conda = 'toytree'
    }

    withName: 'ECTYPER'    { container = 'docker://staphb/ectyper:2.0.0' }
    withName: 'KLEBORATE'  { container = 'docker://staphb/kleborate:3.2.4' }
    withName: 'EMMTYPER'   { container = 'docker://staphb/emmtyper:0.2.0-2412' }
    withName: 'SISTR'       { container = 'docker://staphb/sistr:1.1.3' }
    withName: 'SEROBA'      { container = 'docker://staphb/seroba:2.0.6' }
    withName: 'MENINGOTYPE' { container = 'docker://staphb/meningotype:0.8.5' }
    withName: 'ELGATO'      { container = 'docker://staphb/elgato:1.22.0' }
}

/*
 * Capacity profiles: -profile high_capacity (GTDB-Tk, full Bakta) | -profile low_capacity (sylph, Bakta light)
 * Host size comes from max_cpus / max_memory in conf/env.config; memory doubles on an OOM retry.
 */

// Selectors are anchored ('^(NAME)$'): a plain 'NAME' would replace the main block and drop its container.
profiles {

    high_capacity {
        // Default engine; taxonomy_tool in env.config or on the command line wins.
        params.taxonomy_tool = params.containsKey('taxonomy_tool') ? params.taxonomy_tool : 'gtdbtk'

        process {
            resourceLimits = [ cpus: (params.containsKey('max_cpus') ? params.max_cpus : 64), memory: (params.containsKey('max_memory') ? params.max_memory : 240.GB) ]
            errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 2 ? 'retry' : 'finish' }
            maxRetries     = 2

            withLabel: 'process_low'    { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withLabel: 'process_medium' { cpus = 8;  memory = { 12.GB * task.attempt } }
            withLabel: 'process_high'   { cpus = 16; memory = { 24.GB * task.attempt } }
            withLabel: 'process_max'    { cpus = 24; memory = { 48.GB * task.attempt } }

            withName: '^(VALIDATE_READS)$'   { cpus = 2;  memory = { 4.GB  * task.attempt } }
            withName: '^(SEQKIT_STATS)$'     { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(NANOPLOT)$'         { cpus = 4;  memory = { 8.GB  * task.attempt } }
            withName: '^(FASTPLONG)$'        { cpus = 3;  memory = { 6.GB  * task.attempt } }
            withName: '^(RASUSA)$'           { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(FASTP_SHORT)$'      { cpus = 8;  memory = { 8.GB  * task.attempt } }

            // Assembly: beyond ~16 threads, more parallel samples beat more threads per sample.
            withName: '^(FLYE)$'             { cpus = 16; memory = { 32.GB * task.attempt } }
            withName: '^(MEDAKA)$'           { cpus = 8;  memory = { 16.GB * task.attempt } }
            withName: '^(UNICYCLER)$'        { cpus = 16; memory = { 32.GB * task.attempt } }
            withName: '^(POLYPOLISH_ALIGN)$' { cpus = 16; memory = { 16.GB * task.attempt } }
            withName: '^(POLYPOLISH)$'       { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(DNAAPLER|DNAAPLER_ASSEMBLY)$' { cpus = 4; memory = { 8.GB * task.attempt } }

            withName: '^(ALIGN_LONG|ALIGN_SHORT)$' { cpus = 8; memory = { 12.GB * task.attempt } }
            withName: '^(SAMTOOLS_SORT)$'    { cpus = 8;  memory = { 12.GB * task.attempt } }
            withName: '^(MOSDEPTH)$'         { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(QUAST)$'            { cpus = 4;  memory = { 8.GB  * task.attempt } }
            withName: '^(BUSCO)$'            { cpus = 8;  memory = { 12.GB * task.attempt } }

            withName: '^(GTDBTK)$'           { cpus = 16; memory = { 110.GB * task.attempt }; maxForks = 2 }
            // sylph c200 database needs ~24 GB
            withName: '^(SYLPH_QUERY)$'      { cpus = 8;  memory = { 24.GB * task.attempt }; maxForks = 4 }

            withName: '^(AMRFINDERPLUS)$'    { cpus = 8;  memory = { 8.GB  * task.attempt } }
            withName: '^(RESFINDER)$'        { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(MOB_RECON)$'        { cpus = 8;  memory = { 12.GB * task.attempt } }
            withName: '^(VIRULENCEFINDER)$'  { cpus = 1;  memory = { 4.GB  * task.attempt } }

            withName: '^(ECTYPER)$'          { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(KLEBORATE|SISTR|ELGATO)$' { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: '^(SEROBA)$'           { cpus = 4;  memory = { 8.GB  * task.attempt } }

            // Outbreak and core genome
            withName: '^(MASHTREE)$'         { cpus = 8;  memory = { 8.GB  * task.attempt } }
            withName: '^(SKA_ALIGNMENT)$'    { cpus = 8;  memory = { 8.GB  * task.attempt } }
            withName: '^(IQTREE|IQTREE_CGA)$' { cpus = 8; memory = { 8.GB  * task.attempt } }
            withName: '^(BAKTA_CGA)$'        { cpus = 8;  memory = { 32.GB * task.attempt }; maxForks = 2 }
            withName: '^(PANAROO)$'          { cpus = 12; memory = { 16.GB * task.attempt } }

            withName: '^(MASH_DIST_PLASMIDS)$' { cpus = 2; memory = { 4.GB * task.attempt } }
            withName: '^(MASHTREE_AMR_PLASMIDS)$' { cpus = 4; memory = { 4.GB * task.attempt } }
            withName: '^(PLASMID_ANI_AF)$'   { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(UMAP_PLASMIDS)$'    { cpus = 2;  memory = { 4.GB  * task.attempt } }
            withName: '^(BAKTA_PLASMID_REF)$' { cpus = 4; memory = { 16.GB * task.attempt } }
            withName: '^(COMPARISON_MAP)$'   { cpus = 4;  memory = { 8.GB  * task.attempt } }

            // Surveillance: memory grows with the cumulative population.
            withName: '^(SKA_BUILD)$'        { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(SKA_MERGE)$'        { cpus = 8;  memory = { 24.GB * task.attempt } }
            withName: '^(SKA_DISTANCE)$'     { cpus = 1;  memory = { 24.GB * task.attempt } }
            withName: '^(REPORTREE)$'        { cpus = 4;  memory = { 16.GB * task.attempt } }
            withName: '^(SURVEILLANCE_DISTANCE_MATRIX)$' { cpus = 1; memory = { 8.GB * task.attempt } }

            withName: '^(GENERATE_MULTIQC_CONFIG|BUILD_OUTBREAK_REPORT|BUILD_HGT_REPORT)$' { cpus = 1; memory = { 8.GB * task.attempt } }
            withName: '^(MULTIQC)$'          { cpus = 4;  memory = { 8.GB  * task.attempt } }
        }
    }

    low_capacity {
        params.taxonomy_tool = params.containsKey('taxonomy_tool') ? params.taxonomy_tool : 'sylph'
        // Bakta light database bundled in its image
        params.bakta_db = '/db/db-light'

        process {
            resourceLimits = [ cpus: (params.containsKey('max_cpus') ? params.max_cpus : 16), memory: (params.containsKey('max_memory') ? params.max_memory : 18.GB) ]
            errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 2 ? 'retry' : 'finish' }
            maxRetries     = 2

            withLabel: 'process_low'    { cpus = 1;  memory = { 2.GB  * task.attempt } }
            withLabel: 'process_medium' { cpus = 4;  memory = { 6.GB  * task.attempt } }
            withLabel: 'process_high'   { cpus = 8;  memory = { 10.GB * task.attempt } }
            withLabel: 'process_max'    { cpus = 12; memory = { 12.GB * task.attempt } }

            withName: '^(VALIDATE_READS)$'   { cpus = 2;  memory = { 2.GB  * task.attempt } }
            withName: '^(SEQKIT_STATS)$'     { cpus = 4;  memory = { 2.GB  * task.attempt } }
            withName: '^(NANOPLOT)$'         { cpus = 4;  memory = { 6.GB  * task.attempt } }
            withName: '^(FASTPLONG)$'        { cpus = 3;  memory = { 4.GB  * task.attempt } }
            withName: '^(RASUSA)$'           { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(FASTP_SHORT)$'      { cpus = 4;  memory = { 4.GB  * task.attempt } }

            // Assembly
            withName: '^(FLYE)$'             { cpus = 8;  memory = { 12.GB * task.attempt } }
            withName: '^(MEDAKA)$'           { cpus = 4;  memory = { 8.GB  * task.attempt } }
            withName: '^(UNICYCLER)$'        { cpus = 12; memory = { 12.GB * task.attempt } }
            withName: '^(POLYPOLISH_ALIGN)$' { cpus = 8;  memory = { 8.GB  * task.attempt } }
            withName: '^(POLYPOLISH)$'       { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(DNAAPLER|DNAAPLER_ASSEMBLY)$' { cpus = 4; memory = { 4.GB * task.attempt } }

            withName: '^(ALIGN_LONG|ALIGN_SHORT)$' { cpus = 4; memory = { 6.GB * task.attempt } }
            withName: '^(SAMTOOLS_SORT)$'    { cpus = 4;  memory = { 6.GB  * task.attempt } }
            withName: '^(MOSDEPTH)$'         { cpus = 4;  memory = { 2.GB  * task.attempt } }
            withName: '^(QUAST)$'            { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(BUSCO)$'            { cpus = 4;  memory = { 6.GB  * task.attempt } }

            // sylph c1000 database needs ~6 GB
            withName: '^(SYLPH_QUERY)$'      { cpus = 4;  memory = { 6.GB  * task.attempt }; maxForks = 2 }

            withName: '^(AMRFINDERPLUS)$'    { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(RESFINDER)$'        { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(MOB_RECON)$'        { cpus = 4;  memory = { 6.GB  * task.attempt } }
            withName: '^(VIRULENCEFINDER)$'  { cpus = 1;  memory = { 2.GB  * task.attempt } }

            withName: '^(ECTYPER)$'          { cpus = 2;  memory = { 4.GB  * task.attempt } }
            withName: '^(KLEBORATE|SISTR|ELGATO)$' { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: '^(SEROBA)$'           { cpus = 2;  memory = { 4.GB  * task.attempt } }

            // Outbreak and core genome (Bakta light database)
            withName: '^(MASHTREE)$'         { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: '^(SKA_ALIGNMENT)$'    { cpus = 4;  memory = { 6.GB  * task.attempt } }
            withName: '^(IQTREE|IQTREE_CGA)$' { cpus = 4; memory = { 4.GB  * task.attempt } }
            withName: '^(BAKTA_CGA)$'        {
                container = 'docker://staphb/bakta:1.12.1-6.0-light'
                cpus = 4; memory = { 8.GB * task.attempt }; maxForks = 1
            }
            withName: '^(PANAROO)$'          { cpus = 4;  memory = { 8.GB  * task.attempt } }

            withName: '^(MASH_DIST_PLASMIDS)$' { cpus = 2; memory = { 2.GB * task.attempt } }
            withName: '^(MASHTREE_AMR_PLASMIDS)$' { cpus = 2; memory = { 2.GB * task.attempt } }
            withName: '^(PLASMID_ANI_AF)$'   { cpus = 1;  memory = { 4.GB  * task.attempt } }
            withName: '^(UMAP_PLASMIDS)$'    { cpus = 2;  memory = { 4.GB  * task.attempt } }
            withName: '^(BAKTA_PLASMID_REF)$' {
                container = 'docker://staphb/bakta:1.12.1-6.0-light'
                cpus = 4; memory = { 8.GB * task.attempt }
            }
            withName: '^(COMPARISON_MAP)$'   {
                container = 'docker://staphb/bakta:1.12.1-6.0-light'
                cpus = 2; memory = { 4.GB * task.attempt }
            }

            // Surveillance: memory grows with the cumulative population.
            withName: '^(SKA_BUILD)$'        { cpus = 2;  memory = { 2.GB  * task.attempt } }
            withName: '^(SKA_MERGE)$'        { cpus = 4;  memory = { 8.GB  * task.attempt } }
            withName: '^(SKA_DISTANCE)$'     { cpus = 1;  memory = { 8.GB  * task.attempt } }
            withName: '^(REPORTREE)$'        { cpus = 2;  memory = { 8.GB  * task.attempt } }
            withName: '^(SURVEILLANCE_DISTANCE_MATRIX)$' { cpus = 1; memory = { 4.GB * task.attempt } }

            withName: '^(GENERATE_MULTIQC_CONFIG|BUILD_OUTBREAK_REPORT|BUILD_HGT_REPORT)$' { cpus = 1; memory = { 4.GB * task.attempt } }
            withName: '^(MULTIQC)$'          { cpus = 2;  memory = { 4.GB  * task.attempt } }
        }
    }
}

